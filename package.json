{
  "name": "buildiq",
  "version": "0.2.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "test:l10n": "node tests/l10n/check-l10n.js",
    "test:l10n:write": "node tests/l10n/check-l10n.js --write",
    "postinstall": "patch-package",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src tests scripts",
    "lint-fix": "npm run lint -- --fix",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\"",
    "stylelint-fix": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "l10n:build": "node scripts/build-l10n-js.js",
    "check:schema-l10n": "node scripts/check-schema-l10n.js",
    "check:l10n-js": "node scripts/build-l10n-js.js --check",
    "check:manifest": "node scripts/check-manifest.js",
    "check:gitignore": "node scripts/check-gitignore.js",
    "check:nc-floor": "node scripts/check-nc-floor.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps",
    "test:newman": "newman run tests/integration/buildiq.postman_collection.json --env-var base_url=http://localhost:8080 --env-var admin_user=admin --env-var admin_password=admin",
    "test:newman:ci": "newman run tests/integration/buildiq.postman_collection.json --env-var base_url=http://localhost:8080 --env-var admin_user=admin --env-var admin_password=admin --reporters cli,junit --reporter-junit-export tests/integration/newman-results.xml",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "test:unit:watch": "vitest",
    "test:watch": "vitest"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@conduction/nextcloud-vue": "^2.37.0",
    "@mdi/js": "^7.4.47",
    "@nextcloud/auth": "^2.4.0",
    "@nextcloud/axios": "~2.6.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/password-confirmation": "^6.1.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.11.0",
    "@vueuse/core": "^14.3.0",
    "axe-core": "^4.10.0",
    "dexie": "^4.0.8",
    "diff": "^9.0.0",
    "dompurify": "^3.4.15",
    "floating-vue": "^5.2.2",
    "gridstack": "^13.2.0",
    "marked": "^18.0.12",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.42",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "overrides": {
    "libxmljs2": "^0.37.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/prettier-config": "^1.2.0",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.5.0",
    "css-loader": "~7.1.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "newman": "^6.2.2",
    "patch-package": "^8.0.1",
    "path-browserify": "^1.0.1",
    "postcss-html": "^1.6.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "style-loader": "~4.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.3.0",
    "vue-loader": "^17.4.2",
    "webpack": "^5.110.3",
    "webpack-cli": "^6.0.1"
  },
  "prettier": "@nextcloud/prettier-config"
}
